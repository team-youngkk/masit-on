# 로컬 Docker Compose 전용 값이다. 운영 자격 증명을 여기에 넣지 않는다.
# 사용법: cp .env.example .env

POSTGRES_DB=masiton
POSTGRES_USER=masiton
POSTGRES_PASSWORD=masiton_local
POSTGRES_PORT=5432

REDIS_PORT=6379

WIREMOCK_PORT=8081
# 통합 테스트(WireMockConnectivityIntegrationTest)가 같은 값을 사용한다.
# 버전은 docs/06-architecture/technology-policy.md 3절에 고정돼 있다.
WIREMOCK_IMAGE=wiremock/wiremock:3.13.2-alpine

APP_PORT=8080

# 로컬 전용 관리자 인증 설정이다. 운영 비밀값과 분리하고 Git에 커밋하지 않는다.
# .env를 복사한 뒤 PowerShell에서 `. .\scripts\Initialize-LocalJwt.ps1`를 실행하면
# 로컬 전용 RSA 키를 생성하고, Docker Compose와 현재 bootRun 셸에 값을 주입한다.
JWT_KEY_ID=local-1
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
MEMBER_RATE_LIMIT_SECRET=
MEMBER_TRUSTED_PROXY_ADDRESSES=
MEMBER_REVERSE_PROXY_ENABLED=false
