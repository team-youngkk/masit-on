# 로컬 Docker Compose 전용 값이다. 운영 자격 증명을 여기에 넣지 않는다.
# 사용법: cp .env.example .env

POSTGRES_DB=masiton
POSTGRES_USER=masiton
POSTGRES_PASSWORD=masiton_local
POSTGRES_PORT=5432

REDIS_PORT=6379

WIREMOCK_PORT=8081
# 통합 테스트(WireMockConnectivityIntegrationTest)가 같은 값을 사용한다.
# 버전은 docs/06-architecture/technology-policy.md 3절에 고정돼 있다.
WIREMOCK_IMAGE=wiremock/wiremock:3.13.2-alpine

APP_PORT=8080

# 로컬 전용 관리자 인증 설정이다. 운영 비밀값과 분리하고 Git에 커밋하지 않는다.
# .env를 복사한 뒤 PowerShell에서 `. .\scripts\Initialize-LocalJwt.ps1`를 실행하면
# 로컬 전용 RSA 키를 생성하고, Docker Compose와 현재 bootRun 셸에 값을 주입한다.
JWT_KEY_ID=local-1
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# 로컬 Action 메일 Token 암호화 설정이다. 초기화 스크립트가 32-byte AES 키를 생성한다.
# 운영에서는 이 값을 저장소에 두지 않고 배포 환경의 비밀 관리 수단으로 주입한다.
MEMBER_ACTION_MAIL_ACTIVE_KEY_ID=local-1
MEMBER_ACTION_MAIL_ACTIVE_KEY=

# AI 추출 재시도의 보완 텍스트 암호화 설정이다. 초기화 스크립트가 32-byte AES 키를 생성한다.
# 값이 없으면 관리자 재시도가 AIEXTRACT_TEMPORARY_INPUT_UNAVAILABLE로 실패한다.
AI_TEMPORARY_INPUT_KEY_ID=local-1
AI_TEMPORARY_INPUT_KEY=

# AI 영상 추출은 기본적으로 비활성화·무료 quota 0으로 fail-closed 한다.
# 실제 호출을 허용하려면 아래 모든 게이트와 GEMINI_API_KEY를 명시적으로 검증해 설정한다.
AI_WORKER_ENABLED=false
AI_WORKER_QUOTA_WINDOW=P1D
AI_WORKER_PROVIDER_QUOTA_LIMIT=0
AI_WORKER_APPLICATION_QUOTA_LIMIT=0
GEMINI_ENABLED=false
GEMINI_FREE_TIER_VERIFIED=false
GEMINI_PAID_BILLING_ENABLED=false
GEMINI_API_KEY=

MEMBER_RATE_LIMIT_SECRET=
MEMBER_TRUSTED_PROXY_ADDRESSES=
MEMBER_REVERSE_PROXY_ENABLED=false

RESTAURANT_MAP_TRUSTED_PROXY_ADDRESSES=
RESTAURANT_MAP_REVERSE_PROXY_ENABLED=false
