# 운영 백엔드 컨테이너 — M2-09.
#
# 이미지 참조는 /opt/masiton/etc/backend.image에 있고 app-deploy.sh가 갱신한다.
# unit 파일에 태그를 박지 않는 이유는 배포마다 unit을 고쳐 daemon-reload하지
# 않고 파일 한 줄만 바꿔 재기동하게 하려는 것이다.
#
# Redis는 별도 EC2에서 실행되며, 앱 컨테이너가 원격 endpoint를 검사한다.

[Unit]
Description=masiton backend (Spring Boot, M2-09)
Documentation=https://github.com/team-youngkk/masit-on/blob/main/docs/08-planning/m2-deployment-plan.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=exec
TimeoutStartSec=300
Restart=always
RestartSec=10s

Environment=AWS_REGION=ap-northeast-2

ExecStartPre=-/usr/bin/docker rm -f masiton-backend
# 비밀값은 tmpfs 파일로 주입한다. tmpfs라 재기동하면 사라지므로 매 기동마다 다시
# 만들어야 하고, 렌더링이 실패하면 컨테이너를 띄우지 않아야 한다(`-` 접두사 없음).
ExecStartPre=/opt/masiton/bin/app-secrets-render.sh
ExecStart=/opt/masiton/bin/app-run.sh backend
# graceful shutdown을 설정했으므로(server.shutdown=graceful) 진행 중 요청을
# 마칠 시간을 준다.
ExecStop=/usr/bin/docker stop --time 40 masiton-backend

[Install]
WantedBy=multi-user.target
