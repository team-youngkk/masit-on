aws_region = "ap-northeast-2"
# AWS_PROFILE 환경 변수를 쓸 때는 지정하지 않는다.
# aws_profile = "masiton"

# Existing network and compute inputs. This module does not create VPC, subnet, AMI, RDS, or Redis.
vpc_id = "vpc-REPLACE_ME"

alb_subnet_ids = [
  "subnet-REPLACE_ME_PUBLIC_A",
  "subnet-REPLACE_ME_PUBLIC_C",
]

app_subnet_ids = [
  "subnet-REPLACE_ME_PUBLIC_A",
  "subnet-REPLACE_ME_PUBLIC_C",
]

# 현재 승인된 운영 예시는 public app subnet이다. ALB와 같은 public route를 사용하고
# launch template이 public IPv4를 명시적으로 할당한다. private 모드로 바꾸려면
# private subnet과 NAT gateway egress 경로를 함께 지정하고 비용·운영 조건을 재확인한다.
app_subnet_is_private = false

# docker와 CodeDeploy Agent는 user_data가 설치한다. AMI는 기존 것을 그대로 쓴다.
ami_id        = "ami-REPLACE_ME"
instance_type = "t4g.small"

# ALB는 ACM 종단 후 Nginx 443으로 재암호화한다. HTTP/80 target을 쓰면 Nginx
# 도메인 server의 301이 redirect loop를 만든다.
app_port     = 443
app_protocol = "HTTPS"

# blue ASG는 CodeDeploy 교체 환경 체인의 seed다. blue_desired_capacity=1은 최초
# seeding에 필요한 값이다. 첫 배포 후 replacement가 healthy해지면 이미 실행 중인
# seed를 0대로 내리는 명령을 [정리 runbook](../../../docs/08-planning/blue-green-cleanup-runbook.md)에서
# 실행한다. desired_capacity는 ignore_changes 대상이므로 tfvars만 바꾸지 않는다.
# ASG 자체 설정을 체인에 반영해 다시 seeding할 때만 1대로 복원한다.
blue_min_size         = 0
blue_desired_capacity = 1
blue_max_size         = 2

# 최초 seeding에서는 false로 유지한다. known-good 배포 성공 후
# deployment group의 autoscaling_groups가 replacement ASG를 가리키는 것을
# 확인한 뒤 별도 plan/apply에서 true로 바꿔 성공 배포 후 자동 종료를 활성화한다.
codedeploy_termination_enabled = false

# 새 ASG가 기존 RDS에 접근하려면 RDS SG에 app SG 출처 ingress가 필요하다.
# 끄면 SG ingress에서 drop되어 backend가 Flyway 연결 timeout으로 기동에 실패한다.
manage_rds_ingress_rule = true
# Redis SG의 ingress는 전용 Redis를 소유하는 ../terraform-redis 레이어가 관리한다.
manage_redis_ingress_rule = false

rds_security_group_id   = "sg-REPLACE_ME_RDS"
redis_security_group_id = "sg-REPLACE_ME_REDIS"

# ACM is required for the ALB HTTPS listener. ALB re-encrypts traffic to Nginx on 443.
acm_certificate_arn = "arn:aws:acm:ap-northeast-2:000000000000:certificate/REPLACE_ME"

ecr_repository_arns = [
  "arn:aws:ecr:ap-northeast-2:000000000000:repository/masiton-backend",
  "arn:aws:ecr:ap-northeast-2:000000000000:repository/masiton-frontend",
]

kms_key_arns = ["arn:aws:kms:ap-northeast-2:000000000000:key/REPLACE_ME"]

codedeploy_revision_bucket_name = "masiton-prod-codedeploy-REPLACE_ACCOUNT"

nginx_trusted_proxy_cidrs = [
  "10.0.0.0/16",
]

# Route53 alias is managed only when both values are set.
# route53_zone_id     = "ZREPLACE_ME"
# route53_record_name  = "api.example.com"
# initial_blue_verified = true # known-good blue 검증 후에만 활성화

ssm_parameter_arns = ["arn:aws:ssm:ap-northeast-2:000000000000:parameter/masiton/*"]
# github_actions_role_name = "masiton-github-actions-role"
# Keep secrets out of this file. user_data must install/start CodeDeploy Agent and
# write REQUIRE_SHARED_REDIS=true plus the shared Redis endpoint configuration.
# user_data = <<-EOT
# #!/bin/bash
# # Application bootstrap must resolve secret values from SSM using the instance role.
# install -d -m 0750 /etc/masiton
# cat > /etc/masiton/deployment.env <<'ENV'
# REQUIRE_SHARED_REDIS=true
# REDIS_HOST=redis.internal.example
# REDIS_PORT=6379
# NGINX_TRUSTED_PROXY_CIDRS=10.0.1.0/24,10.0.2.0/24
# ENV
# EOT

# ---- 최초 seeding 구간에만 필요한 완화 ----
# 앱이 없는 빈 baseline에서는 ELB health check와 alarm 게이트, 자동 rollback이
# 첫 배포를 막는다. 아래 두 입력은 tfvars에 저장하지 말고, 최초 known-good
# revision을 올리는 단 한 번의 명령에만 함께 넘긴다. 배포가 성공하면 즉시
# 기본값(ELB / true / true / initial_alarm_seeding=false)으로 복원한다.
# terraform plan -var="initial_alarm_seeding=true" -var="deployment_alarms_enabled=false" -out=initial-seed.tfplan
# terraform apply initial-seed.tfplan
# asg_health_check_type            = "EC2"
# initial_alarm_seeding             = true
# deployment_alarms_enabled         = false
# deployment_auto_rollback_enabled = false

