aws_region = "ap-northeast-2"
# AWS_PROFILE 환경 변수를 쓸 때는 지정하지 않는다.
# aws_profile = "masiton"

# Existing network and compute inputs. This module does not create VPC, subnet, AMI, RDS, or Redis.
vpc_id = "vpc-REPLACE_ME"

app_subnet_ids = [
  "subnet-REPLACE_ME_PUBLIC_A",
  "subnet-REPLACE_ME_PUBLIC_C",
]

# 현재 운영 예시는 public app subnet이다. public route를 사용하고 launch template이
# public IPv4를 명시적으로 할당한다. private 모드로 바꾸려면
# private subnet과 NAT gateway egress 경로를 함께 지정하고 비용·운영 조건을 재확인한다.
app_subnet_is_private = false

# 직접 서비스할 단일 앱 EC2. 기존 앱을 재사용할 때는 이 인스턴스를 확인한 뒤
# aws_instance.app으로 import하고, 새로 만들 때만 Terraform이 생성하게 한다.
app_subnet_id            = "subnet-REPLACE_ME_PUBLIC_A"
app_ingress_cidr_blocks  = ["0.0.0.0/0"]

# PostgreSQL EC2에는 기존 RDS SG와 분리된 전용 DB SG를 사용한다.
# database_security_group_id에는 그 전용 SG를 넣고, rds_security_group_id에는
# 기존 legacy DB SG를 유지한다. 두 값이 같아도 direct 앱 ingress는 별도로 생성된다.
database_security_group_id = "sg-REPLACE_ME_POSTGRESQL_EC2"
database_port              = 5432

# 단일 EC2 외부 smoke와 DNS 전환이 완료된 운영 구성은 true로 유지한다.
direct_traffic_enabled = true

# 직접 앱 EC2의 docker·SSM Agent는 direct user_data가 설치한다. AMI는 기존 것을
# 그대로 쓴다.
ami_id        = "ami-REPLACE_ME"
instance_type = "t4g.small"

# Nginx가 ACM 인증서로 TLS를 종단하고 외부 80 요청을 HTTPS로 redirect한다.
app_port     = 443
app_protocol = "HTTPS"

# blue ASG와 target group은 기존 전환 이력과 Terraform state를 보존하기 위한 seed다.
# 단일 EC2 SSM 배포에는 사용하지 않는다. desired_capacity는 ignore_changes 대상이므로
# tfvars만 바꾸지 않는다.
blue_min_size         = 0
blue_desired_capacity = 1
blue_max_size         = 2

# 새 ASG가 기존 RDS에 접근하려면 RDS SG에 app SG 출처 ingress가 필요하다.
# 끄면 SG ingress에서 drop되어 backend가 Flyway 연결 timeout으로 기동에 실패한다.
manage_rds_ingress_rule = true
# Redis SG의 ingress는 전용 Redis를 소유하는 ../terraform-redis 레이어가 관리한다.
manage_redis_ingress_rule = false

rds_security_group_id   = "sg-REPLACE_ME_RDS"
redis_security_group_id = "sg-REPLACE_ME_REDIS"

# ACM certificate used by Nginx for direct HTTPS termination.
acm_certificate_arn = "arn:aws:acm:ap-northeast-2:000000000000:certificate/REPLACE_ME"

ecr_repository_arns = [
  "arn:aws:ecr:ap-northeast-2:000000000000:repository/masiton-backend",
  "arn:aws:ecr:ap-northeast-2:000000000000:repository/masiton-frontend",
]

kms_key_arns = ["arn:aws:kms:ap-northeast-2:000000000000:key/REPLACE_ME"]

codedeploy_revision_bucket_name = "masiton-prod-codedeploy-REPLACE_ACCOUNT"

nginx_trusted_proxy_cidrs = [
  "10.0.0.0/16",
]

# Route53 A record is managed only when both values are set.
# route53_zone_id     = "ZREPLACE_ME"
# route53_record_name  = "api.example.com"

ssm_parameter_arns = ["arn:aws:ssm:ap-northeast-2:000000000000:parameter/masiton/*"]
# github_actions_role_name = "masiton-github-actions-role"
# Keep secrets out of this file. user_data must install/start SSM Agent and write
# REQUIRE_SHARED_REDIS=true plus the shared Redis endpoint configuration.
# user_data = <<-EOT
# #!/bin/bash
# # Application bootstrap must resolve secret values from SSM using the instance role.
# install -d -m 0750 /etc/masiton
# cat > /etc/masiton/deployment.env <<'ENV'
# REQUIRE_SHARED_REDIS=true
# REDIS_HOST=redis.internal.example
# REDIS_PORT=6379
# NGINX_TRUSTED_PROXY_CIDRS=10.0.1.0/24,10.0.2.0/24
# ENV
# EOT

# 기존 seed ASG는 0대로 유지하며 자동 배포에는 사용하지 않는다.
