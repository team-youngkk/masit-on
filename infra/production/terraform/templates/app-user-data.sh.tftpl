#!/bin/bash
# 앱 ASG 인스턴스의 최소 bootstrap.
#
# 애플리케이션 배포는 CodeDeploy revision(appspec.yml -> instance-bootstrap.sh)이
# 수행한다. 여기서는 배포 에이전트와 공통 실행 조건만 만든다. 이미지 태그·버전을
# 여기에 넣으면 launch template이 배포마다 바뀌어 ASG가 인스턴스를 교체한다.
#
# 비밀값을 기록하지 않는다. app-run.sh와 app-secrets-render.sh가 인스턴스 role로
# Parameter Store에서 읽는다.
set -euxo pipefail

REGION=${aws_region}

# app-deploy.sh는 docker를, CodeDeploy Agent 설치 스크립트는 ruby를 요구한다.
dnf install -y docker ruby wget
systemctl enable --now docker

# CodeDeploy Agent가 없으면 인스턴스가 배포 대상으로 등록되지 않아
# COPY_AUTO_SCALING_GROUP으로 만든 green이 배포를 받지 못하고 전환이 실패한다.
if ! systemctl is-active --quiet codedeploy-agent; then
  agent_tmp=$(mktemp -d)
  wget -q -O "$agent_tmp/install" \
    "https://aws-codedeploy-$REGION.s3.$REGION.amazonaws.com/latest/install"
  chmod +x "$agent_tmp/install"
  "$agent_tmp/install" auto
  rm -rf "$agent_tmp"
fi
systemctl enable --now codedeploy-agent

# 색상이 바뀌어도 세션·Refresh Token·rate-limit 상태가 유지되어야 하므로 로컬
# Redis를 설치하지 않는다. instance-bootstrap.sh의 INSTALL_LOCAL_REDIS 기본값이
# false라 별도로 끄지 않는다. 공유 endpoint는 app-run.sh가 Parameter Store의
# /masiton/redis/host 에서 읽고, REQUIRE_SHARED_REDIS가 그 값이 없을 때
# 기동을 실패시켜 빈 Redis로 트래픽을 받는 것을 막는다.
#
# NGINX_TRUSTED_PROXY_CIDRS는 ALB가 붙인 X-Forwarded-For만 신뢰하게 하는 경계다.
# 넓히면 외부가 보낸 XFF로 client IP가 바뀌어 로그인 rate-limit 출처가 위조된다.
install -d -m 0750 /etc/masiton
cat > /etc/masiton/deployment.env <<'ENV'
REQUIRE_SHARED_REDIS=true
NGINX_TRUSTED_PROXY_CIDRS=${nginx_trusted_proxy_cidrs}
ENV
chmod 0640 /etc/masiton/deployment.env
