#!/bin/bash
set -euo pipefail

exec > >(tee /var/log/masiton-perf-bootstrap.log | logger -t masiton-perf-bootstrap -s 2>/dev/console) 2>&1

# curl은 설치 목록에 넣지 않는다. AL2023에 기본 설치된 curl-minimal이 이미
# /usr/bin/curl을 제공하고, 전체 curl 패키지와 파일이 충돌해 dnf 트랜잭션이
# 실패한다. set -e 때문에 이 한 줄이 부트스트랩 전체를 중단시켰다.
dnf install -y docker tar
systemctl enable --now docker

mkdir -p /opt/masiton-perf
chown -R root:root /opt/masiton-perf

# GC 로그 디렉터리만 컨테이너 사용자(uid 1001)에게 준다. root 소유로 마운트하면
# JVM이 -Xlog 파일을 열지 못해 "Could not create the Java Virtual Machine"으로
# 기동 자체가 실패한다. 운영에는 이 옵션이 없어 드러나지 않는 조건이다.
install -d -m 0755 -o 1001 -g 1001 /opt/masiton-perf/gc

# WireMock과 Redis는 이 인스턴스에서 돌지 않는다. 운영 앱 인스턴스가 두 자원을
# 동거시키지 않으므로 성능 환경도 별도 dependency 인스턴스로 분리한다. 같은
# 호스트에 두면 호스트 메모리 여유가 운영과 달라져 측정값을 대변하지 못한다.

cat >/opt/masiton-perf/runtime.env <<'RUNTIME_ENV'
AWS_REGION=${aws_region}
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USERNAME=${db_username}
DB_PASSWORD_PARAMETER=${db_param_name}
APP_IMAGE_URI=${app_image_uri}
WIREMOCK_BASE_URL=http://${deps_private_ip}:8081
REDIS_HOST=${deps_private_ip}
REDIS_PORT=6379
REDIS_PASSWORD_PARAMETER=${redis_param_name}
GC_LOG_HOST_DIR=/opt/masiton-perf/gc
GC_LOG_CONTAINER_DIR=/var/log/masiton-gc
JAVA_TOOL_OPTIONS=-Xlog:gc*:file=/var/log/masiton-gc/gc.log:time,uptime,level,tags:filecount=5,filesize=10M
RUNTIME_ENV
chmod 0600 /opt/masiton-perf/runtime.env

cat >/opt/masiton-perf/check-dependencies.sh <<'CHECK_DEPENDENCIES'
#!/bin/bash
set -euo pipefail

attempts=30
interval=2

# Redis requirepass를 명령행에 두지 않는다. 같은 인스턴스의 ps에서 읽힌다.
# 값은 변수에만 담고 검증이 끝나면 지운다.
redis_password=$(aws ssm get-parameter \
  --region '${aws_region}' \
  --name '${redis_param_name}' \
  --with-decryption \
  --query 'Parameter.Value' --output text | tr -d '\r\n')

if [ -z "$redis_password" ] || [ "$redis_password" = 'None' ]; then
  echo 'Parameter Store에서 Redis requirepass를 읽지 못했다' >&2
  exit 1
fi

# RESP inline 명령으로 AUTH 뒤에 PING을 보낸다. 응답은 CRLF로 끝나므로 read가
# 남기는 CR까지 감안해 접두사로 본다. 셸 파라미터 확장을 쓰지 않는 이유는 이
# 파일이 Terraform 템플릿이어서 $${...} 표기가 templatefile() 보간과 충돌하기
# 때문이다.
redis_ping() {
  auth_response=''
  ping_response=''
  exec 3<>"/dev/tcp/${deps_private_ip}/6379" || return 1
  printf 'AUTH %s\r\nPING\r\n' "$redis_password" >&3
  IFS= read -r -t 5 auth_response <&3
  IFS= read -r -t 5 ping_response <&3
  exec 3>&-
  case "$auth_response" in
  '+OK'*) ;;
  # 도달 불가와 인증 실패를 구분해야 원인을 바로 안다. 서버 오류 문구만 남기고
  # 비밀값은 출력하지 않는다.
  '-'*)
    echo "Redis AUTH rejected: $auth_response" >&2
    return 1
    ;;
  *) return 1 ;;
  esac
  case "$ping_response" in
  '+PONG'*) return 0 ;;
  *) return 1 ;;
  esac
}

# grep -q가 파이프를 먼저 닫으면 pipefail이 curl의 쓰기 실패를 잡으므로
# 본문을 변수로 받은 뒤 검사한다.
wiremock_mappings() {
  body=''
  body=$(curl --fail --silent --show-error --max-time 5 \
    "http://${deps_private_ip}:8081/__admin/mappings") || return 1
  case "$body" in
  *'"mappings"'*) return 0 ;;
  *) return 1 ;;
  esac
}

wait_for() {
  name=$1
  check=$2
  for attempt in $(seq 1 "$attempts"); do
    if "$check"; then
      echo "$name: OK"
      return 0
    fi
    if [ "$attempt" -eq "$attempts" ]; then
      echo "$name failed after $attempts attempts: ${deps_private_ip}" >&2
      return 1
    fi
    sleep "$interval"
  done
}

wait_for 'Redis AUTH+PING' redis_ping
unset redis_password
wait_for 'WireMock mappings' wiremock_mappings
CHECK_DEPENDENCIES
chmod 0700 /opt/masiton-perf/check-dependencies.sh

# prod 프로파일은 configtree로 비밀값 파일 10건을 읽는다. 성능 환경은 운영 비밀값에
# 접근하지 않으므로(app 역할은 이 실행의 db·redis parameter 둘만 읽는다) 나머지
# 8건을 이 인스턴스에서 일회용으로 만든다. 검증 세션은 이 환경에서 명시적으로
# 비활성화하며, 부하 시나리오는 무인증 공개 GET만
# 호출하므로 그 값들은 기동 요건을 채우는 역할만 한다.
# 파일 이름이 곧 속성 이름이고 경로도 운영과 같다. 원문은
# deploy/scripts/app-secrets-render.sh와 application-prod.yml이다.
cat >/opt/masiton-perf/render-secrets.sh <<'RENDER_SECRETS'
#!/bin/bash
set -euo pipefail

SECRETS_DIR=/run/masiton/secrets
APP_UID=1001
APP_GID=1001

install -d -m 0711 /run/masiton
install -d -m 0500 -o "$APP_UID" -g "$APP_GID" "$SECRETS_DIR"
find "$SECRETS_DIR" -mindepth 1 -maxdepth 1 -type f -delete

# CR만 걷어낸다. PEM은 개행을 보존해야 파싱된다.
write_secret() {
  path="$SECRETS_DIR/$1"
  umask 077
  printf '%s' "$(printf %s "$2" | tr -d '\r')" >"$path"
  chown "$APP_UID:$APP_GID" "$path"
  chmod 0400 "$path"
}

from_ssm() {
  value=$(aws ssm get-parameter --region '${aws_region}' --name "$1" \
    --with-decryption --query 'Parameter.Value' --output text)
  if [ -z "$value" ] || [ "$value" = 'None' ]; then
    echo "필수 비밀값을 읽지 못했다: $1" >&2
    exit 1
  fi
  printf %s "$value"
}

throwaway() {
  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
}

write_secret 'spring.datasource.password' "$(from_ssm '${db_param_name}')"
write_secret 'spring.data.redis.password' "$(from_ssm '${redis_param_name}')"

# JwtConfiguration이 기동 시점에 파싱하므로 형식이 유효해야 한다. 측정은 무인증
# 경로만 쓰므로 실행마다 새 키를 만든다. tmpfs에만 있고 destroy와 함께 사라진다.
key_dir=$(mktemp -d)
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$key_dir/private.pem" >/dev/null 2>&1
openssl rsa -in "$key_dir/private.pem" -pubout -out "$key_dir/public.pem" >/dev/null 2>&1
write_secret 'masiton.security.jwt.key-id' "perf-$(cat /proc/sys/kernel/random/uuid)"
write_secret 'masiton.security.jwt.private-key-pem' "$(cat "$key_dir/private.pem")"
write_secret 'masiton.security.jwt.public-key-pem' "$(cat "$key_dir/public.pem")"
rm -rf "$key_dir"

# 아래는 형식 검증이 없고 측정 경로에서 쓰이지 않는다. 운영 값을 복제하지 않는다.
write_secret 'masiton.member.action-mail.active-key-id' 'perf'
write_secret 'masiton.member.action-mail.active-key' "$(throwaway)"
write_secret 'masiton.member.rate-limit.secret' "$(throwaway)"
write_secret 'spring.mail.username' 'perf@example.invalid'
write_secret 'spring.mail.password' "$(throwaway)"

echo "비밀값 렌더링 완료: $SECRETS_DIR ($(find "$SECRETS_DIR" -type f | wc -l)건)"
RENDER_SECRETS
chmod 0700 /opt/masiton-perf/render-secrets.sh

# 운영 deploy/scripts/app-run.sh의 backend 분기를 성능 환경에 맞춘 것이다.
# 비밀값은 환경 변수로 넘기지 않고 tmpfs 마운트로만 전달한다. 컨테이너 메모리
# 제한은 운영과 같은 1024m이어야 JVM heap 상한과 GC 선택이 같아진다.
cat >/opt/masiton-perf/start-backend.sh <<'START_BACKEND'
#!/bin/bash
set -euo pipefail

/opt/masiton-perf/check-dependencies.sh
/opt/masiton-perf/render-secrets.sh

SECRETS_DIR=/run/masiton/secrets
export SECRETS_DIR

export SPRING_PROFILES_ACTIVE=prod
export VERIFICATION_ENABLED=false
# prod 프로파일은 server.address가 127.0.0.1로 고정되어 있다(application-prod.yml).
# 성능 환경에서는 loadgen 인스턴스가 네트워크를 통해 호출하므로 0.0.0.0으로 열어야 한다.
export SERVER_ADDRESS=0.0.0.0
export DB_URL='jdbc:postgresql://${db_host}:${db_port}/${db_name}'
export DB_USERNAME='${db_username}'
export REDIS_HOST='${deps_private_ip}'
export REDIS_PORT=6379

# 외부 연동은 WireMock으로만 보낸다. 실제 Kakao·YouTube API를 호출하지 않는다.
export KAKAO_BASE_URL='http://${deps_private_ip}:8081'
export YOUTUBE_BASE_URL='http://${deps_private_ip}:8081'

# 운영과 다른 지점이다. 성능 환경에는 SMTP가 없고 메일 자격 증명도 복제하지
# 않으므로 메일 준비성 검사를 끄고 의존 검사 대상에서 뺀다. 부하 시나리오는
# 메일 경로를 쓰지 않는다. 이 차이는 결과 문서에 적는다.
export MAIL_HOST=127.0.0.1
export MAIL_PORT=25
export MAIL_HEALTH_ENABLED=false
export DEPENDENCY_HEALTH_COMPONENTS=db,redis

# 키가 없고 Kakao Mobility는 base URL 허용 목록이 WireMock을 받지 않는다.
export KAKAO_MOBILITY_ENABLED=false
export KAKAO_MOBILITY_FREE_TIER_VERIFIED=false
export AI_WORKER_ENABLED=false
export AI_WORKER_PROVIDER_QUOTA_LIMIT=0
export AI_WORKER_APPLICATION_QUOTA_LIMIT=0
export AI_WORKER_QUOTA_WINDOW=P1D
export GEMINI_ENABLED=false
export GEMINI_FREE_TIER_VERIFIED=false
export GEMINI_PAID_BILLING_ENABLED=false

# prod 프로파일은 인증 origin이 HTTPS여야 한다고 강제한다(MemberCookieSettings가
# "Production authentication origins must use HTTPS"로 기동을 막는다). 측정은 무인증
# 공개 GET만 쓰므로 이 값으로 요청이 나가지 않지만, 운영과 같은 값을 두어 쿠키·CORS
# 설정이 운영과 같은 상태로 측정된다.
app_origin="https://masiton.click"
export AUTH_ALLOWED_ORIGINS="$app_origin"
export MEMBER_TRUSTED_PROXY_ADDRESSES=127.0.0.1
export MEMBER_REVERSE_PROXY_ENABLED=true
export AUTH_LOGIN_TRUSTED_PROXY_ADDRESSES=127.0.0.1
export AUTH_LOGIN_REVERSE_PROXY_ENABLED=true
export RESTAURANT_MAP_TRUSTED_PROXY_ADDRESSES=127.0.0.1
export RESTAURANT_MAP_REVERSE_PROXY_ENABLED=true
export YOUTUBE_WEBHOOK_CALLBACK_URL="$app_origin/api/webhooks/youtube/channel-updates"

# JAVA_TOOL_OPTIONS의 GC 로그는 측정 전용이다. 컨테이너 안 경로를 호스트에
# 마운트해야 회수할 수 있다. 운영에는 이 옵션이 없다.
set -a
. /opt/masiton-perf/runtime.env
set +a

# digest 고정 이미지는 ECR에서 받는다. 인스턴스 역할에 읽기 권한이 있으므로
# 자격 증명을 따로 두지 않고 registry 토큰만 받아 로그인한다.
registry=$(printf %s '${app_image_uri}' | cut -d/ -f1)
aws ecr get-login-password --region '${aws_region}' |
  docker login --username AWS --password-stdin "$registry" >/dev/null
docker pull '${app_image_uri}'

docker rm -f masiton-perf-backend 2>/dev/null || true
install -d -m 0755 -o 1001 -g 1001 /opt/masiton-perf/gc

docker run -d --name masiton-perf-backend \
  --network host \
  --memory 1024m \
  --restart unless-stopped \
  --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
  --volume "$SECRETS_DIR":"$SECRETS_DIR":ro \
  --volume /opt/masiton-perf/gc:/var/log/masiton-gc \
  -e SPRING_PROFILES_ACTIVE \
  -e VERIFICATION_ENABLED \
  -e SERVER_ADDRESS \
  -e DB_URL -e DB_USERNAME \
  -e REDIS_HOST -e REDIS_PORT \
  -e KAKAO_BASE_URL -e YOUTUBE_BASE_URL \
  -e KAKAO_MOBILITY_ENABLED -e KAKAO_MOBILITY_FREE_TIER_VERIFIED \
  -e MAIL_HOST -e MAIL_PORT -e MAIL_HEALTH_ENABLED -e DEPENDENCY_HEALTH_COMPONENTS \
  -e AUTH_ALLOWED_ORIGINS \
  -e MEMBER_TRUSTED_PROXY_ADDRESSES -e MEMBER_REVERSE_PROXY_ENABLED \
  -e AUTH_LOGIN_TRUSTED_PROXY_ADDRESSES -e AUTH_LOGIN_REVERSE_PROXY_ENABLED \
  -e RESTAURANT_MAP_TRUSTED_PROXY_ADDRESSES -e RESTAURANT_MAP_REVERSE_PROXY_ENABLED \
  -e AI_WORKER_ENABLED -e AI_WORKER_PROVIDER_QUOTA_LIMIT \
  -e AI_WORKER_APPLICATION_QUOTA_LIMIT -e AI_WORKER_QUOTA_WINDOW \
  -e GEMINI_ENABLED -e GEMINI_FREE_TIER_VERIFIED -e GEMINI_PAID_BILLING_ENABLED \
  -e YOUTUBE_WEBHOOK_CALLBACK_URL \
  -e JAVA_TOOL_OPTIONS \
  -e SECRETS_DIR \
  '${app_image_uri}'

echo '컨테이너 기동 요청 완료. 준비성은 /internal/health/ready로 확인한다.'
START_BACKEND
chmod 0700 /opt/masiton-perf/start-backend.sh

cat >/opt/masiton-perf/start-backend-note.txt <<'NOTE'
The infrastructure is ready. Start the backend with /opt/masiton-perf/start-backend.sh
through an audited SSM command. It verifies both dependencies, renders the secret files to
tmpfs and runs the digest-pinned image with the production memory limit.

Secrets never reach a command line or the container spec: only /run/masiton/secrets is
mounted read-only and application-prod.yml reads it with configtree. Only the database and
Redis passwords come from Parameter Store; the remaining required values are throwaway ones
generated on this instance because the load scenarios exercise unauthenticated public reads.

Do not put a password in user-data, shell history, GitHub workflow inputs, or repository files.
NOTE
